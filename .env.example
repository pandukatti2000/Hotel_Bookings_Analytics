# StayWise AI — Environment Configuration Example

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hotel_bookings_db
DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password_here@localhost:5432/hotel_bookings_db

# Read-Only Database Role (Restricted for AI Query Execution)
POSTGRES_READONLY_USER=hotel_readonly
POSTGRES_READONLY_PASSWORD=ReadOnly@StayWise2026
READONLY_DATABASE_URL=postgresql+psycopg2://hotel_readonly:ReadOnly%40StayWise2026@localhost:5432/hotel_bookings_db

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=staywise-hotel-analytics

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
